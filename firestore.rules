rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /purchases/{purchaseId} {
      allow read, write: if false;
    }
    match /rankings/{uid} {
      allow read: if true;
      allow write: if false;
    }
    match /matchRankings/{uid} {
      allow read: if true;
      // Photon clients record their own result directly after a completed match.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['wins', 'losses', 'updatedAt'])
        && request.resource.data.wins is int
        && request.resource.data.losses is int
        && request.resource.data.wins >= 0
        && request.resource.data.losses >= 0
        && request.resource.data.wins + request.resource.data.losses == 1;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['wins', 'losses', 'updatedAt'])
        && request.resource.data.wins is int
        && request.resource.data.losses is int
        && request.resource.data.wins >= resource.data.wins
        && request.resource.data.losses >= resource.data.losses
        && request.resource.data.wins <= resource.data.wins + 1
        && request.resource.data.losses <= resource.data.losses + 1
        && request.resource.data.wins + request.resource.data.losses
           == resource.data.wins + resource.data.losses + 1;
      allow delete: if false;
    }
    match /photonClientReports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'sessionName', 'won'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.sessionName is string
        && request.resource.data.won is bool;
      allow read, update, delete: if false;
    }
    match /photonMatchResults/{matchId} {
      allow read, write: if false;
    }
    match /matchInvitations/{inviteId} {
      allow read, write: if false;
    }
    match /matches/{matchId} {
      allow read, write: if false;
    }
  }
}
